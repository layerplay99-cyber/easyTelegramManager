APP_NAME=CatchAdmin后台管理系统
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_BASE_URL=${APP_URL}/api/
VITE_APP_NAME=${APP_NAME}

# 前端广播 / 外部 API（构建时注入，改动后必须重新 build 前端）
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_WSS_URL=
VITE_API_KEY="${EXTERNAL_API_KEY}"

ALIOSS_BUCKET=
ALIOSS_ACCESS_ID=
ALIOSS_ACCESS_SECRET=
ALIOSS_ENDPOINT=
ALIOSS_UPLOAD_DIR=

# 外部 API 校验密钥（与前端 VITE_API_KEY 一致）
EXTERNAL_API_KEY=

# Reverb（WebSocket 广播，与前端 VITE_REVERB_* 一致）
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http

# 认证 / 会话
#
# ⚠️ 这两个只影响「浏览器 -> Nginx -> PHP」这一跳，与容器间通信无关
#    （容器内部走 Docker 网络服务名 mysql / redis / telegram-py，不经过 cookie）
#
# SANCTUM_STATEFUL_DOMAINS：浏览器地址栏的域名（不含协议；端口非 80/443 时要带端口）
# SESSION_DOMAIN：cookie 域名；带前导点(.dg178.top)表示允许子域共享，
#                 单域名场景用不带点的完整域名更精确安全
#
# 单域名方案（前端与 API 同域，推荐）：
SANCTUM_STATEFUL_DOMAINS=bot.dg178.top
SESSION_DOMAIN=bot.dg178.top
#
# 若前端 dev server 直连（:5173）跨端口访问 API：
#   SANCTUM_STATEFUL_DOMAINS=bot.dg178.top,localhost:5173,127.0.0.1:5173
#   并同步配置 config/cors.php（allowed_origins + supports_credentials=true）

# 项目代码在宿主的共享目录（与 docker-compose.yml 挂载路径对应）
# Docker 部署时：PROJECTS_ROOT=/var/www   PROJECT_DIR=项目目录名
PROJECTS_ROOT=.
PROJECT_DIR=telegram-bot
