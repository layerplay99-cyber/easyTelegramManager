# ============================================================================
# deploy-test.sh 的外部配置（测试 / 共享环境）
# 用法：cp deploy.env.test.example deploy.env.test，然后按需修改（主要就是 DOMAIN）
# 说明：deploy.env.test 的值会覆盖 deploy-test.sh 配置区的默认值
# ============================================================================

# ★★★ 测试域名（边缘 nginx 用 server_name 匹配）★★★
#   会写进：Laravel APP_URL / SANCTUM / SESSION / REVERB_HOST、
#          前端 VITE_BASE_URL / VITE_REVERB_HOST / VITE_WSS_URL、
#          内部 nginx server_name、边缘反代 vhost 的 server_name
DOMAIN=bot-test.example.com

# http / https（TLS 在你的边缘 nginx 终止，本项目内部 nginx 固定走 80）
PROTO=https

# ---------------------------------------------------------------- 路径
# 项目代码在宿主的目录（默认取脚本所在目录，一般不用改）
# PROJECT_HOST_DIR=/var/www/easyTelegramManager
# PROJECT_DIR=easyTelegramManager
# PROJECTS_ROOT=/var/www

STACK_ROOT=/opt/docker-stack

# ---------------------------------------------------------------- 代码
GIT_REPO=https://github.com/layerplay99-cyber/easyTelegramManager.git
GIT_BRANCH=main

# ---------------------------------------------------------------- 数据库（测试库，与生产隔离）
MYSQL_ROOT_PASSWORD=root
DB_DATABASE=bots_test
DB_USERNAME=bots_test
DB_PASSWORD=bots_test123
DB_PREFIX=bmt

# ---------------------------------------------------------------- 边缘 nginx
# 你现有的、占了 80/443 的那个 nginx 容器名（反代目标从这里接）
EDGE_NGINX_CONTAINER=easycall-nginx
# 本项目内部 nginx 在 stack 网络里的地址（不用改）
EDGE_PROXY_TARGET=tgbot-nginx:80

# ---------------------------------------------------------------- 其它
SERVE_MODE=dist

# 密钥，留空则自动生成随机值（生成后写进 .env，之后不再变）
# EXTERNAL_API_KEY=
# TELETHON_CALLBACK_TOKEN=
# REVERB_APP_ID=160452
# REVERB_APP_KEY=
# REVERB_APP_SECRET=

SKIP_IMAGE_BUILD=0
