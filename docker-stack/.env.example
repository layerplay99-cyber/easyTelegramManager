# 复制为 /opt/docker-stack/.env 后按需修改

# 共享栈根目录（配置/数据都落在这里，位于 /opt 共用区）
STACK_ROOT=/opt/docker-stack
# 所有项目代码统一存放目录
PROJECTS_ROOT=/opt/projects

TZ=Asia/Shanghai

# ---------------- MySQL ----------------
# 默认库/用户与现有 telegram-bot 项目 .env 对齐，可直接复用
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bots
MYSQL_USER=bots
MYSQL_PASSWORD=bots123456
MYSQL_PORT=3306

# ---------------- Redis ----------------
REDIS_PORT=6379

# ---------------- PostgreSQL ----------------
# POSTGRES_USER(stack) 为超级用户，各项目可用它自行建库
PGSQL_USER=stack
PGSQL_PASSWORD=stack123456
PGSQL_DATABASE=stack
PGSQL_PORT=5432

# ---------------- Nginx ----------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
