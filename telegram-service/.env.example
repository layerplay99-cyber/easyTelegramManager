# 共享媒体目录（与 PHP 容器共享同一卷）
MEDIA_DIR=/data/media
# Telethon .session 目录
SESSIONS_DIR=/data/sessions

# 事件回调到 Laravel：必须指向提供 HTTP 的 nginx（php 容器是 php-fpm，无 HTTP 端口）
LARAVEL_BASE_URL=http://stack-nginx
# nginx 按 server_name 路由，需与项目 vhost 的 server_name 一致
LARAVEL_HOST=tgbot.local
# 与 Laravel config('telethon.callback_token') 一致
CALLBACK_TOKEN=change-me

# 采集表情开关用的 Redis（与 Laravel 共用）
REDIS_URL=redis://redis:6379/0
EMOJI_SWITCH_PREFIX=telegram_group_collect_emojis_

LOG_LEVEL=INFO
