# ============================================================================
# deploy.sh 的外部配置
# 用法：cp deploy.env.example deploy.env，然后按需修改（主要就是 DOMAIN）
# 说明：deploy.env 里的值会覆盖 deploy.sh 配置区的默认值
# ============================================================================

# ★★★ 域名（唯一必改项）★★★
#   会同时写入：Nginx server_name、Laravel APP_URL / SANCTUM / SESSION / REVERB_HOST、
#               前端 VITE_BASE_URL / VITE_REVERB_HOST / VITE_WSS_URL、
#               Telethon 的 LARAVEL_HOST（回调时带这个 Host，Nginx 才能路由对）
DOMAIN=bot.example.com

# http / https
PROTO=https

# 是否启用 HTTPS。启用后会把证书路径写进 vhost。
# 证书你自己准备（certbot / 云厂商都行），放到下面的路径即可。
ENABLE_SSL=1
SSL_CERT=/etc/nginx/ssl/bot.example.com/fullchain.pem
SSL_KEY=/etc/nginx/ssl/bot.example.com/privkey.pem

# ---------------------------------------------------------------- 路径
# 项目代码在宿主的目录（默认取 deploy.sh 所在目录，一般不用改）
# PROJECT_HOST_DIR=/var/www/easyTelegramManager
# 项目目录名（默认取目录 basename）
# PROJECT_DIR=easyTelegramManager
# 项目父目录（compose 挂载用，默认取 PROJECT_HOST_DIR 的上一级）
# PROJECTS_ROOT=/var/www

# 共享栈目录（mysql/redis/nginx 都在里面）
STACK_ROOT=/opt/docker-stack
# 共享栈定义来源（仓库里的 docker-stack/）
# STACK_SRC=./docker-stack

# ---------------------------------------------------------------- 代码
GIT_REPO=https://github.com/layerplay99-cyber/easyTelegramManager.git
GIT_BRANCH=main

# ---------------------------------------------------------------- 数据库
MYSQL_ROOT_PASSWORD=root
DB_DATABASE=bots
DB_USERNAME=bots
DB_PASSWORD=bots123456
DB_PREFIX=bm

# ---------------------------------------------------------------- 其它
# 前端托管：dist = Nginx 直接托管 web/dist（生产推荐）；dev = 反代 vite dev server
SERVE_MODE=dist

# 密钥，留空则自动生成随机值（生成后写进 .env，之后不再变）
# EXTERNAL_API_KEY=
# TELETHON_CALLBACK_TOKEN=
# REVERB_APP_ID=160452
# REVERB_APP_KEY=
# REVERB_APP_SECRET=

# 本地 Telegram Bot API Server（TDLib）身份：my.telegram.org → API development tools 申请。
# 留空也能部署，只是 telegram-bot-api 容器会启动即退出（日志刷 expected TELEGRAM_API_ID...），
# 出站 Bot API 仍走官方 https://api.telegram.org/bot。要用本地 TDLib 必填，
# 并且还要在项目 .env 把 TELEGRAM_BASE_BOT_URL 改成 http://telegram-bot-api:8083/bot。
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# 共享栈镜像已存在时可设 1，跳过 build 提速
SKIP_IMAGE_BUILD=0
