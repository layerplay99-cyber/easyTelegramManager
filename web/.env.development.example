# 本地开发环境模板：cp web/.env.development.example web/.env.development
#
# vite 的环境文件优先级（同名 key 以高优先级为准）：
#   npm run dev   (mode=development) -> .env.development  >  .env
#   npm run build (mode=production)  -> .env.production    >  .env
# 所以 .env 只放生产/默认配置，本地开发覆盖放这里，两边互不影响。

VITE_BASE_URL=http://127.0.0.1:8088/api

VITE_APP_NAME=机器人后台管理

VITE_REVERB_APP_KEY=zsrxcva12bcezt6ghu6o
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_REVERB_USE_TLS=false

VITE_WSS_URL=ws://127.0.0.1:8080

# 与后端 .env 的 EXTERNAL_API_KEY 保持一致
VITE_API_KEY=
