APP_NAME=CatchAdmin后台管理系统
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_BASE_URL=${APP_URL}/api/
VITE_APP_NAME=${APP_NAME}

# 前端广播 / 外部 API（构建时注入，改动后必须重新 build 前端）
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_WSS_URL=
VITE_API_KEY="${EXTERNAL_API_KEY}"

ALIOSS_BUCKET=
ALIOSS_ACCESS_ID=
ALIOSS_ACCESS_SECRET=
ALIOSS_ENDPOINT=
ALIOSS_UPLOAD_DIR=

# 外部 API 校验密钥（与前端 VITE_API_KEY 一致）
EXTERNAL_API_KEY=

# Reverb（WebSocket 广播，与前端 VITE_REVERB_* 一致）
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http

# 认证 / 会话
#
# ⚠️ 这两个只影响「浏览器 -> Nginx -> PHP」这一跳，与容器间通信无关
#    （容器内部走 Docker 网络服务名 mysql / redis / telegram-py，不经过 cookie）
#
# SANCTUM_STATEFUL_DOMAINS：浏览器地址栏的域名（不含协议；端口非 80/443 时要带端口）
# SESSION_DOMAIN：cookie 域名；带前导点(.dg178.top)表示允许子域共享，
#                 单域名场景用不带点的完整域名更精确安全
#
# 单域名方案（前端与 API 同域，推荐）：
SANCTUM_STATEFUL_DOMAINS=bot.dg178.top
SESSION_DOMAIN=bot.dg178.top
#
# 若前端 dev server 直连（:5173）跨端口访问 API：
#   SANCTUM_STATEFUL_DOMAINS=bot.dg178.top,localhost:5173,127.0.0.1:5173
#   并同步配置 config/cors.php（allowed_origins + supports_credentials=true）

# 项目代码在宿主的共享目录（与 docker-compose.yml 挂载路径对应）
# Docker 部署时：PROJECTS_ROOT=/var/www   PROJECT_DIR=项目目录名
PROJECTS_ROOT=.
PROJECT_DIR=telegram-bot

# 本地 Telegram Bot API Server（TDLib）的 TDLib 身份
#
# my.telegram.org → API development tools 申请。
# ⚠️ 等同账号凭证，只进 .env，不要提交 git（.env 已在 .gitignore 里）。
#
# 只给 docker-compose.yml 里的 telegram-bot-api 服务用（ compose 把它传进容器 env）。
# 没填的话那个容器起来就退出并刷日志：
#   error: expected TELEGRAM_API_ID or TELEGRAM_API_ID_FILE env vars to be set
# 看日志：docker logs tgbot-bot-api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot API 基础地址
#
# 默认走官方 https://api.telegram.org/bot，留空即可。
# 部署了本地 Telegram Bot API Server（TDLib）时改成它的地址，例如：
#   http://telegram-bot-api:8083/bot   （Docker / stack 网络）
#   http://127.0.0.1:8083/bot          （宿主机同机）
# 收益：Bot API 调用走内网降延迟；--local 模式下文件上限从 20MB/50MB 提到 2GB
# 注意必须写到 /bot 这一级；部署方式见 docs/telegram-bot-api-server.md
#
# ⚠️ 换这个地址只影响「出站」调用（发消息、getFile、下载媒体）。
#    「入站」走的是 Telegram 推送到 /api/webhook/pull，与这个地址无关。
#    换完之后要在后台把每个机器人重新「关闭 → 激活」一次，
#    并用「查看状态」确认 url 和 pending_update_count。
TELEGRAM_BASE_BOT_URL=

# 注意：没有「全局 bot token」这项配置。本项目是多 bot 多商户，
# 每个机器人的 token 存在后台「机器人管理」里（bmbots.api_token），
# 业务侧按订单 / 绑定 / 会话确定用哪个机器人，不设兜底。

# 下载 Telegram 媒体文件（识图要先把图片取回来）的超时，秒
TELEGRAM_MEDIA_DOWNLOAD_TIMEOUT=30

# ==========================================================
# OCR 识图（AWS Textract）
# ==========================================================
# 通用的一套凭证，不用按商户区分，所以放 .env 而不是后台「上游配置」。
# IAM 用户需要有 textract:DetectDocumentText 权限。
#
# 注意：AWS 没有「api key」这个概念，这里要填的是 IAM 用户的
#   Access Key ID      → AWS_ACCESS_KEY_ID
#   Secret Access Key  → AWS_SECRET_ACCESS_KEY
# 留空的话识图功能会直接提示「未配置 AWS_ACCESS_KEY_ID」。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Textract 所在区域，影响接口延迟与语言支持
AWS_REGION=us-east-1

# 默认 OCR 引擎（对应 config/telegram.php 的 ocr.drivers）
AWS_OCR_DEFAULT=textract

# 单次 OCR 的硬超时（秒）。OCR 是重活，别让它把队列 worker 占死
AWS_OCR_TIMEOUT=15

# 传给 Textract 的最大图片字节数（同步接口上限 10MB，默认留 1MB 余量）
AWS_OCR_MAX_BYTES=9437184
