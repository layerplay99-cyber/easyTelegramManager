# 生产构建配置模板
#
# 用法：cp web/.env.example web/.env.production  然后按实际环境填写
#
# vite 环境文件优先级（同名 key 以高优先级为准）：
#   yarn dev   (mode=development) -> .env.development  >  .env
#   yarn build (mode=production)  -> .env.production    >  .env
# 即：生产配置放 .env.production（本文件的副本），本地开发覆盖放 .env.development，两边互不影响。
#
# ⚠️ VITE_* 是「构建时」注入的，改完必须重新 yarn build 才生效。

# 后端 API 地址（生产域名）
VITE_BASE_URL=https://bot.dg178.top/api

VITE_APP_NAME=机器人后台管理

# Laravel Reverb WebSocket —— 与后端 .env 的 REVERB_* 保持一致
# 单域名方案：WebSocket 走主域名的 /app（由 Nginx 反代到 reverb:8080）
# 所以 HOST 填主域名、PORT 填 Nginx 的 443（不是 reverb 的 8080）
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=bot.dg178.top
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_REVERB_USE_TLS=true

VITE_WSS_URL=wss://bot.dg178.top/app

# 与后端 .env 的 EXTERNAL_API_KEY 保持一致
VITE_API_KEY=
