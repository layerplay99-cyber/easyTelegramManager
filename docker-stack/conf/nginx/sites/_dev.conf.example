# ============================================================================
# telegram-bot 项目虚拟主机 —— 本机开发用示例（不是生产配置）
# ----------------------------------------------------------------------------
# ⚠️ 为什么叫 .example：nginx 只 include /etc/nginx/sites/*.conf，
#    .example 不会被加载。本文件以前叫 telegram-bot.conf，会被 deploy.sh 的
#    `cp -a docker-stack/. /opt/docker-stack/` 一起复制进生产 nginx，
#    结果生产机上多出一个 server_name tgbot.local、前端反代 5173 dev server 的
#    开发站点（Telethon 回调带 Host: tgbot.local 还会命中它）。已改名避免误加载。
#
# 生产 vhost 由 deploy.sh 生成：/opt/docker-stack/conf/nginx/sites/<项目目录名>.conf
#   server_name = 真实域名，location / 托管 web/dist，/api 走 php-fpm。
# 模板见同目录 _template.conf.example。
#
# 本机开发要用：cp _dev.conf.example telegram-bot.conf，并在 /etc/hosts 加
#   127.0.0.1 tgbot.local
# ----------------------------------------------------------------------------
# 前置：本项目的 app 容器已接入 `stack` 网络，容器名分别为：
#   tgbot-php / tgbot-frontend / tgbot-reverb
# 改完执行：docker exec <nginx容器> nginx -s reload
# ============================================================================

server {
    listen 80;
    server_name tgbot.local;

    client_max_body_size 50m;

    # ---- 前端 SPA（vite dev，含 HMR）----
    # 生产环境可改为直接 serve 构建产物 web/dist（见文末注释）。
    #
    # ⚠️ 所有上游都用「变量」形式：配合 nginx.conf 里的 resolver，容器重建后
    #    IP 变了也能自动跟上。直接写 http://名字:端口 的话，nginx 只在启动时
    #    解析一次，容器一重建就连不上（502）。
    location / {
        set                    $frontend_upstream "tgbot-frontend:5173";
        proxy_pass             http://$frontend_upstream;
        proxy_http_version     1.1;
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
        # HMR websocket
        proxy_set_header       Upgrade $http_upgrade;
        proxy_set_header       Connection "upgrade";
        proxy_read_timeout     3600s;
    }

    # ---- API：交给 php-fpm ----
    location /api {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        # 变量形式才会走 resolver 动态解析，见 nginx.conf 里的说明
        set            $php_upstream "tgbot-php:9000";
        fastcgi_pass   $php_upstream;
        fastcgi_index  index.php;
        # 与 php/app 容器内挂载路径一致：/opt/projects/easyTelegramManager
        fastcgi_param  SCRIPT_FILENAME /opt/projects/easyTelegramManager/public$fastcgi_script_name;
        include        fastcgi_params;
    }

    # ---- Reverb WebSocket 反代 ----
    # 同样用变量：reverb 容器重建后 IP 会变，写死会连不上（WS 连不上、页面无推送）
    location /app {
        set                    $reverb_upstream "tgbot-reverb:8080";
        proxy_pass             http://$reverb_upstream;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade $http_upgrade;
        proxy_set_header       Connection "Upgrade";
        proxy_set_header       Host $host;
        proxy_read_timeout     3600s;
        proxy_send_timeout     3600s;
    }
}

# ============================================================================
# ============================================================================
# 【路由约定：单域名 + path 区分】
#   /            -> 前端页面
#   /api         -> 后端接口（php-fpm）
#   /app         -> Reverb WebSocket（反代到 tgbot-reverb:8080）
#
# 前端 web/.env* 必须与此保持一致（尤其 VITE_REVERB_PORT 要填 Nginx 的端口，
# 不是 reverb 的 8080）：
#   VITE_BASE_URL      = http://<域名>/api
#   VITE_REVERB_HOST   = <域名>
#   VITE_REVERB_PORT   = 80   （HTTPS 时填 443）
#   VITE_REVERB_SCHEME = http （HTTPS 时填 https）
#   VITE_WSS_URL       = ws://<域名>/app （HTTPS 时 wss://<域名>/app）
# ============================================================================

# ----------------------------------------------------------------------------
# 生产环境（推荐）：`yarn build` 产出 web/dist 后由 Nginx 直接托管静态，
# 不再依赖 tgbot-frontend 容器。把上面 location / 替换为：
#
#   location / {
#       root /opt/projects/easyTelegramManager/web/dist;
#       try_files $uri $uri/ /index.html;
#   }
#   location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
#       root /opt/projects/easyTelegramManager/web/dist;
#       expires 7d;
#       add_header Cache-Control "public";
#   }
#
# 需要 HTTPS 时，在 server 块加：
#   listen 443 ssl;
#   ssl_certificate     /etc/nginx/ssl/<域名>/fullchain.pem;
#   ssl_certificate_key /etc/nginx/ssl/<域名>/privkey.pem;
# 并另加一个 80 端口的 server 做 301 跳转：
#   server { listen 80; server_name <域名>; return 301 https://$host$request_uri; }
# ----------------------------------------------------------------------------
