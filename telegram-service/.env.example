# 共享媒体目录（与 PHP 容器共享同一卷）
MEDIA_DIR=/data/media
# Telethon .session 目录
SESSIONS_DIR=/data/sessions

# 事件回调到 Laravel（填 php 服务在 stack 网络里的地址）
LARAVEL_BASE_URL=http://php
# 与 Laravel config('telethon.callback_token') 一致
CALLBACK_TOKEN=change-me

# 采集表情开关用的 Redis（与 Laravel 共用）
REDIS_URL=redis://redis:6379/0
EMOJI_SWITCH_PREFIX=telegram_group_collect_emojis_

LOG_LEVEL=INFO
