# ============================================================================
# 新项目 vhost 模板
# ----------------------------------------------------------------------------
# 用法：复制本文件为 <project>.conf，替换下列占位符后放到
#       docker-stack/conf/nginx/sites/，然后 reload nginx：
#       docker compose -f docker-stack/docker-compose.yml exec nginx nginx -s reload
#
# 注意：本文件扩展名为 .example，不会被 nginx 的 include *.conf 加载；
#       复制为 .conf 后才生效。
#
# 占位符：
#   <DOMAIN_LIST>  对外域名列表（空格分隔，支持多个域名 / 子域名指向同一项目）
#                 例如：demo.local www.demo.local api.demo.local
#   <CONTAINER> 项目容器名前缀，需与项目 docker-compose.yml 里的 container_name 一致
#               （例如 telegram-bot -> tgbot-php / tgbot-frontend / tgbot-reverb）
#   <PROJECT>   项目代码目录名，对应 /opt/projects/<PROJECT>
#   <PORT>      前端 vite 端口（默认 5173）
#
# 说明：本模板与数据库类型无关；pgsql 项目只需在自身 .env 设
#       DB_CONNECTION=pgsql / DB_HOST=pgsql 即可，Nginx 无需改动。
# ============================================================================

server {
    listen 80;
    # 多域名：空格分隔，例如  demo.local www.demo.local api.demo.local
    server_name <DOMAIN_LIST>;

    client_max_body_size 50m;

    # ---- 前端 SPA（vite dev，含 HMR）----
    # 生产用构建产物时，改为直接 serve web/dist（见 telegram-bot.conf 文末注释）。
    location / {
        proxy_pass             http://<CONTAINER>-frontend:<PORT>;
        proxy_http_version     1.1;
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
        proxy_set_header       Upgrade $http_upgrade;
        proxy_set_header       Connection "upgrade";
        proxy_read_timeout     3600s;
    }

    # ---- API：交给 php-fpm ----
    location /api {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass   <CONTAINER>-php:9000;
        fastcgi_index  index.php;
        # 与 php/app 容器内挂载路径一致：/opt/projects/<PROJECT>
        fastcgi_param  SCRIPT_FILENAME /opt/projects/<PROJECT>/public$fastcgi_script_name;
        include        fastcgi_params;
    }

    # ---- WebSocket（如用 Reverb，容器名 <CONTAINER>-reverb）----
    location /app {
        proxy_pass             http://<CONTAINER>-reverb:8080;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade $http_upgrade;
        proxy_set_header       Connection "Upgrade";
        proxy_set_header       Host $host;
        proxy_read_timeout     3600s;
        proxy_send_timeout     3600s;
    }
}
